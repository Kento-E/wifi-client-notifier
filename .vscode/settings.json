{
  "chat.tools.terminal.autoApprove": {
    "env": true,
    "true": true,
    "command": true,
    "gh": true,
    "flake8": true,
    "python": true,
    ".venv/bin/python": true,
    "printf": true,
    ".venv/bin/black": true,
    ".venv/bin/flake8": true,
    "git rev-parse": true,
    "ssh": true,
    "/^bash -n deployment/setup_raspberrypi\\.sh$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^bash -n deployment/setup_raspberrypi\\.sh && echo \"syntax_ok\"$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "scp": true,
    "black": true,
    "/^source \\.venv/bin/activate && flake8 src/ scripts/$/": {
      "approve": true,
      "matchCommandLine": true
    }
  },
  "cSpell.words": ["raspberrypi"]
}
