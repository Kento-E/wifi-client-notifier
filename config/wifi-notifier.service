[Unit]
Description=WiFi Client Notifier
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
# ARPスキャンモードでは CAP_NET_RAW ケーパビリティが必要です
# root権限の代わりにケーパビリティを使用することでセキュリティを向上させています
User=root
Group=root
WorkingDirectory=/path/to/wifi-client-notifier
ExecStart=/usr/bin/python3 /path/to/wifi-client-notifier/src/wifi_notifier.py /path/to/wifi-client-notifier/config.yaml

# 失敗時に再起動
Restart=on-failure
RestartSec=30

# セキュリティ設定
# NoNewPrivileges=true を維持しつつ、ARPスキャンに必要なケーパビリティのみを付与
NoNewPrivileges=true
PrivateTmp=true
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
ReadWritePaths=/path/to/wifi-client-notifier

# ログ設定
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wifi-notifier

[Install]
WantedBy=multi-user.target
